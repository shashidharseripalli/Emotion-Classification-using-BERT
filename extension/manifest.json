{
  "manifest_version": 3,
  "name": "Emotion Lens — BERT Emotion Classifier",
  "version": "1.0.1",
  "description": "Analyze the emotion expressed in text you type or select on a webpage.",
  "permissions": ["activeTab", "scripting", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "http://localhost:8000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "Analyze emotion",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}